{
  "name": "motive-routine-builder",
  "version": "0.1.0",
  "private": true,
  "description": "Build and follow your own movement sessions, with an animated library and private on-device routines.",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/library.test.mjs tests/routine.test.mjs",
    "test:site": "node --test tests/site.test.mjs",
    "release:check": "node scripts/check-release.mjs",
    "audit": "npm audit --audit-level=high",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:site && npm run release:check"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "lucide-react": "1.49.0",
    "next": "16.3.7",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.7",
    "typescript": "5.9.3"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.28",
      "sharp": "0.35.5"
    }
  },
  "type": "module"
}
